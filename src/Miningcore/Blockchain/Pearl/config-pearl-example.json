{
    "//": "Pearl pool config. The pool talks to PEARLD (the node), which speaks",
    "//2": "standard btcd JSON-RPC: getblocktemplate / submitblock / getblockchaininfo.",
    "//3": "pearld RPC default port = 44107 (mainnet). Oyster WALLET = 44207 (used only",
    "//4": "for payouts, not implemented yet). pearld serves TLS by default; set ssl:true,",
    "//5": "or run pearld with --notls and set ssl:false.",

    "logging": {
        "level": "info",
        "enableConsoleLog": true,
        "enableConsoleColors": true,
        "logFile": "pool.log",
        "logBaseDirectory": "/home/eman/miningcorePRL/logs",
        "perPoolLogFile": true
    },
    "banning": { "manager": "Integrated" },
    "notifications": { "enabled": false },
    "persistence": {
        "postgres": {
            "host": "127.0.0.1",
            "port": 5432,
            "user": "miningcore",
            "password": "your-password",
            "database": "miningcore"
        }
    },
    "paymentProcessing": { "enabled": false },
    "pools": [
        {
            "id": "pearl1",
            "enabled": true,
            "coin": "pearl",
            "address": "YOUR_PEARL_TAPROOT_MINING_ADDRESS",
            "blockRefreshInterval": 1000,
            "jobRebroadcastTimeout": 10,
            "clientConnectionTimeout": 600,
            "banning": { "enabled": false },
            "ports": {
                "3333": {
                    "listenAddress": "0.0.0.0",
                    "difficulty": 1,
                    "name": "Pearl"
                }
            },
            "daemons": [
                {
                    "//": "PEARLD node RPC (NOT the oyster wallet). Mainnet RPC port 44107.",
                    "host": "127.0.0.1",
                    "port": 44107,
                    "user": "pearlrpc",
                    "password": "YOUR_PEARLD_RPC_PASSWORD",
                    "ssl": true
                }
            ],
            "paymentProcessing": {
                "enabled": false,
                "minimumPayment": 1,
                "payoutScheme": "PPLNS",
                "payoutSchemeConfig": { "factor": 2 },
                "extra": {
                    "walletPrivateKey": ""
                }
            },
            "extra": {
                "maxActiveJobs": 4,
                "extraNonce1Size": 4,
                "pythonExecutable": "python3",
                "pythonBridgeScript": "/home/eman/miningcorePRL/build-pearl/pearl_mining_bridge.py"
            }
        }
    ]
}
